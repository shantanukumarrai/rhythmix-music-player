# ========================================
# Rhythmix - Environment Configuration
# ========================================
# Copy this to .env and fill in your values

NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/rhythmix
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/rhythmix

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d

# File Upload Paths
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_AUDIO=mp3,flac,wav,ogg,aac,m4a
ALLOWED_IMAGE=jpg,jpeg,png,webp

# CORS
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15     # minutes
RATE_LIMIT_MAX=100       # requests per window

# Socket.io (for real-time lyrics sync)
SOCKET_CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
